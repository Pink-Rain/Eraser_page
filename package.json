{
  "name": "eraser-page",
  "version": "0.4.0",
  "private": true,
  "description": "Eraser Page : l'atelier des pages d'Eraser, publié comme extension.",
  "eraserExtension": {
    "id": "page",
    "api": 2,
    "entry": "main.js",
    "styles": [
      "main.css"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-types.mjs",
    "pack": "node scripts/pack-extension.mjs dist release",
    "release": "npm run build && npm run check && npm test && npm run pack",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@tailwindcss/cli": "4.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.25.12",
    "lucide-react": "1.31.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
